puted","activeStep","map","pending","processing","completed","rejected","undefined","mounted","fetchDetail","activated","methods","_this","_asyncToGenerator","_regenerator","m","_callee","res","w","_context","p","n","$API","maintenanceApi","getDetail","$route","params","v","code","Object","assign","f","a","changeStatus","_this2","_callee2","statusLabel","_context2","update","$message","success","concat"],"sources":["src/views/maintenance/MaintenanceDetailView.vue"],"sourcesContent":["<template>\n  <div class=\"page-container\">\n    <el-card shadow=\"never\" v-loading=\"loading\">\n      <div slot=\"header\" style=\"display:flex;justify-content:space-between;align-items:center;\">\n        <span style=\"font-size:18px;font-weight:600;\">维修详情 #{{ record.id }}</span>\n        <div>\n          <el-button size=\"small\" @click=\"$router.back()\">返回列表</el-button>\n          <el-button size=\"small\" type=\"primary\" @click=\"$router.push(`/maintenance/edit/${record.id}`)\">编辑</el-button>\n        </div>\n      </div>\n\n      <el-row :gutter=\"24\">\n        <el-col :span=\"16\">\n          <el-descriptions :column=\"2\" border>\n            <el-descriptions-item label=\"维修标题\" :span=\"2\">{{ record.title }}</el-descriptions-item>\n            <el-descriptions-item label=\"维修位置\">{{ record.location }}</el-descriptions-item>\n            <el-descriptions-item label=\"楼栋\">{{ record.building }}</el-descriptions-item>\n            <el-descriptions-item label=\"楼层\">{{ record.floor }}</el-descriptions-item>\n            <el-descriptions-item label=\"房间\">{{ record.room }}</el-descriptions-item>\n            <el-descriptions-item label=\"分类\">\n              <el-tag>{{record.category}}</el-tag>\n            </el-descriptions-item>\n            <el-descriptions-item label=\"状态\">\n              <el-tag :type=\"statusType[record.status]\">{{ statusMap[record.status] }}</el-tag>\n            </el-descriptions-item>\n            <el-descriptions-item label=\"维修人\">{{ record.reporter_name }}</el-descriptions-item>\n            <el-descriptions-item label=\"提交时间\">{{ formatDate(record.created_at) }}</el-descriptions-item>\n            <el-descriptions-item label=\"维修公司\">{{ record.handler_name || '-' }}</el-descriptions-item>\n            <el-descriptions-item label=\"开始维修时间\">{{ record.repair_start_date || '-' }}</el-descriptions-item>\n            <el-descriptions-item label=\"维修结束时间\">{{ record.repair_end_date || '-' }}</el-descriptions-item>\n            <el-descriptions-item label=\"问题描述\" :span=\"2\">{{ record.description || '无' }}</el-descriptions-item>\n            <!-- 现场图片：有图片时显示缩略图，点击可预览大图 -->\n            <el-descriptions-item label=\"现场图片\" :span=\"2\" v-if=\"record.images && record.images.length\">\n              <div style=\"display:flex;flex-wrap:wrap;gap:8px;\">\n                <el-image v-for=\"(img, idx) in record.images\" :key=\"idx\" :src=\"img\" :preview-src-list=\"record.images\" fit=\"cover\" style=\"width:100px;height:100px;border-radius:4px;\" />\n              </div>\n            </el-descriptions-item>\n            <el-descriptions-item label=\"关联模型构件\" :span=\"2\">\n              <el-tag v-if=\"record.model_element_id\" type=\"success\">\n                {{ record.model_element_name || record.model_element_id }}\n                <!-- 点击跳转到 BIM 页面，传递 elementId 用于自动定位构件 -->\n                <el-button type=\"text\" size=\"small\" @click=\"$router.push({ path: '/bim', query: { model_element_id: record.model_element_id } })\" style=\"margin-left:8px;\">查看模型</el-button>\n              </el-tag>\n              <span v-else style=\"color:#909399;\">未关联</span>\n            </el-descriptions-item>\n          </el-descriptions>\n        </el-col>\n        <el-col :span=\"8\">\n          <el-card shadow=\"never\" style=\"margin-bottom:16px;\">\n            <div slot=\"header\"><span>状态流转</span></div>\n            <el-steps direction=\"vertical\" :active=\"activeStep\" finish-status=\"success\" style=\"height: 260px;\">\n              <el-step title=\"提交时间\" :description=\"formatDate(record.created_at)\" />\n              <el-step title=\"处理中\" :description=\"record.status == 'processing' ? '已分配' : '待处理'\" />\n              <el-step title=\"已完成\" :description=\"record.completed_at ? formatDate(record.completed_at) : ''\" />\n            </el-steps>\n          </el-card>\n          <el-card shadow=\"never\">\n            <div slot=\"header\"><span>快速操作</span></div>\n            <div style=\"display:flex;flex-direction:column;gap:8px;\">\n              <el-button v-if=\"record.status === 'pending'\" type=\"warning\" @click=\"changeStatus('processing')\">开始处理</el-button>\n              <el-button v-if=\"record.status === 'processing'\" type=\"success\" @click=\"changeStatus('completed')\">标记完成</el-button>\n            </div>\n          </el-card>\n        </el-col>\n      </el-row>\n    </el-card>\n  </div>\n</template>\n\n<script>\nimport {\n  categoryMap,\n  statusMap,\n  statusType,\n} from \"../../config/constants\";\nimport { formatDate } from \"../../utils\";\n\nexport default {\n  name: \"MaintenanceDetailView\",\n  data() {\n    return {\n      loading: true,\n      record: {\n        id: \"\",\n        title: \"\",\n        description: \"\",\n        location: \"\",\n        building: \"\",\n        floor: \"\",\n        room: \"\",\n        category: \"other\",\n        status: \"pending\",\n        reporter_name: \"\",\n        handler_name: \"\",\n        created_at: \"\",\n        completed_at: \"\",\n        repair_start_date: \"\",\n        repair_end_date: \"\",\n        model_element_id: \"\",\n        model_element_name: \"\",\n        images: [],\n      },\n      categoryMap,\n      statusMap,\n      statusType,\n    };\n  },\n  computed: {\n    activeStep() {\n      const map = { pending: 0, processing: 1, completed: 2, rejected: 0 };\n      return map[this.record.status] !== undefined\n        ? map[this.record.status]\n        : 0;\n    },\n  },\n  mounted() {\n    this.fetchDetail();\n  },\n  activated() {\n    this.fetchDetail();\n  },\n  methods: {\n    formatDate,\n    async fetchDetail() {\n      this.loading = true;\n      try {\n        const res = await this.$API.maintenanceApi.getDetail(\n          this.$route.params.id\n        );\n        if (res.code === 200) {\n          Object.assign(this.record, res.data);\n        }\n      } finally {\n        this.loading = false;\n      }\n    },\n    async changeStatus(status) {\n      const statusLabel = {\n        processing: \"处理中\",\n        completed: \"已完成\",\n        rejected: \"已驳回\",\n      };\n      const res = await this.$API.maintenanceApi.update(this.$route.params.id, {\n        status,\n      });\n      if (res.code === 200) {\n        this.$message.success(`已标记为${statusLabel[status]}`);\n      }\n      this.fetchDetail();\n    },\n  },\n};\n</script>\n"],"mappings":";;AAsEA,SACAA,WAAA,EACAC,SAAA,EACAC,UAAA,QACA;AACA,SAAAC,UAAA;AAEA;EACAC,IAAA;EACAC,IAAA,WAAAA,KAAA;IACA;MACAC,OAAA;MACAC,MAAA;QACAC,EAAA;QACAC,KAAA;QACAC,WAAA;QACAC,QAAA;QACAC,QAAA;QACAC,KAAA;QACAC,IAAA;QACAC,QAAA;QACAC,MAAA;QACAC,aAAA;QACAC,YAAA;QACAC,UAAA;QACAC,YAAA;QACAC,iBAAA;QACAC,eAAA;QACAC,gBAAA;QACAC,kBAAA;QACAC,MAAA;MACA;MACAzB,WAAA,EAAAA,WAAA;MACAC,SAAA,EAAAA,SAAA;MACAC,UAAA,EAAAA;IACA;EACA;EACAwB,QAAA;IACAC,UAAA,WAAAA,WAAA;MACA,IAAAC,GAAA;QAAAC,OAAA;QAAAC,UAAA;QAAAC,SAAA;QAAAC,QAAA;MAAA;MACA,OAAAJ,GAAA,MAAArB,MAAA,CAAAS,MAAA,MAAAiB,SAAA,GACAL,GAAA,MAAArB,MAAA,CAAAS,MAAA,IACA;IACA;EACA;EACAkB,OAAA,WAAAA,QAAA;IACA,KAAAC,WAAA;EACA;EACAC,SAAA,WAAAA,UAAA;IACA,KAAAD,WAAA;EACA;EACAE,OAAA;IACAlC,UAAA,EAAAA,UAAA;IACAgC,WAAA,WAAAA,YAAA;MAAA,IAAAG,KAAA;MAAA,OAAAC,iBAAA,cAAAC,YAAA,GAAAC,CAAA,UAAAC,QAAA;QAAA,IAAAC,GAAA;QAAA,OAAAH,YAAA,GAAAI,CAAA,WAAAC,QAAA;UAAA,kBAAAA,QAAA,CAAAC,CAAA,GAAAD,QAAA,CAAAE,CAAA;YAAA;cACAT,KAAA,CAAAhC,OAAA;cAAAuC,QAAA,CAAAC,CAAA;cAAAD,QAAA,CAAAE,CAAA;cAAA,OAEAT,KAAA,CAAAU,IAAA,CAAAC,cAAA,CAAAC,SAAA,CACAZ,KAAA,CAAAa,MAAA,CAAAC,MAAA,CAAA5C,EACA;YAAA;cAFAmC,GAAA,GAAAE,QAAA,CA