-button>\n    </div>\n\n    <el-table :data=\"list\" stripe v-loading=\"loading\" style=\"width:100%\">\n      <el-table-column prop=\"id\" label=\"编号\" width=\"70\" />\n      <el-table-column prop=\"title\" label=\"标题\" min-width=\"160\" show-overflow-tooltip />\n      <el-table-column prop=\"location\" label=\"位置\" min-width=\"160\" show-overflow-tooltip />\n      <el-table-column prop=\"building\" label=\"楼栋\" width=\"100\" />\n      <el-table-column prop=\"category\" label=\"分类\" width=\"90\">\n        <template slot-scope=\"{ row }\">{{ categoryMap[row.category] }}</template>\n      </el-table-column>\n      <el-table-column prop=\"priority\" label=\"优先级\" width=\"90\">\n        <template slot-scope=\"{ row }\">\n          <el-tag :type=\"priorityType[row.priority]\">{{ priorityMap[row.priority] }}</el-tag>\n        </template>\n      </el-table-column>\n      <el-table-column prop=\"status\" label=\"状态\" width=\"90\">\n        <template slot-scope=\"{ row }\">\n          <el-tag :type=\"statusType[row.status]\">{{ statusMap[row.status] }}</el-tag>\n        </template>\n      </el-table-column>\n      <el-table-column prop=\"reporter_name\" label=\"报修人\" width=\"90\" />\n      <el-table-column prop=\"created_at\" label=\"报修时间\" width=\"170\">\n        <template slot-scope=\"{ row }\">{{ formatDate(row.created_at) }}</template>\n      </el-table-column>\n      <el-table-column label=\"模型关联\" width=\"90\">\n        <template slot-scope=\"{ row }\">\n          <el-tag v-if=\"row.model_element_id\" type=\"success\" size=\"small\">已关联</el-tag>\n          <el-tag v-else type=\"info\" size=\"small\">未关联</el-tag>\n        </template>\n      </el-table-column>\n      <el-table-column label=\"操作\" width=\"180\" fixed=\"right\">\n        <template slot-scope=\"{ row }\">\n          <el-button type=\"text\" size=\"small\" @click=\"$router.push('/maintenance/detail/' + row.id)\">详情</el-button>\n          <el-button type=\"text\" size=\"small\" @click=\"$router.push('/maintenance/edit/' + row.id)\">编辑</el-button>\n          <el-popconfirm title=\"确认删除?\" @confirm=\"handleDelete(row.id)\">\n            <el-button slot=\"reference\" type=\"text\" size=\"small\" style=\"color:#f56c6c;\">删除</el-button>\n          </el-popconfirm>\n        </template>\n      </el-table-column>\n    </el-table>\n\n    <el-pagination\n      v-if=\"total > 0\"\n      style=\"margin-top: 16px; text-align: right;\"\n      :current-page=\"query.page\"\n      :page-size=\"query.pageSize\"\n      :total=\"total\"\n      :page-sizes=\"[10, 20, 50]\"\n      layout=\"total, sizes, prev, pager, next, jumper\"\n      @current-change=\"handlePageChange\"\n      @size-change=\"handleSizeChange\"\n    />\n  </div>\n</template>\n\n<script>\nimport { maintenanceApi } from '../../api'\n\nexport default {\n  name: 'MaintenanceListView',\n  data() {\n    return {\n      list: [],\n      total: 0,\n      loading: false,\n      query: { page: 1, pageSize: 10, keyword: '', status: '', category: '', priority: '' },\n      categoryMap: { electrical: '电气', plumbing: '水暖', furniture: '家具', door_window: '门窗', floor: '地面', wall: '墙面', other: '其他' },\n      priorityMap: { low: '低', medium: '中', high: '高', urgent: '紧急' },\n      statusMap: { pending: '待处理', processing: '处理中', completed: '已完成', rejected: '已驳回' },\n      priorityType: { low: 'info', medium: '', high: 'warning', urgent: 'danger' },\n      statusType: { pending: 'warning', processing: '', completed: 'success', rejected: 'danger' }\n    }\n  },\n  mounted() {\n    this.fetchList()\n  },\n  methods: {\n    formatDate(d) {\n      return d ? new Date(d).toLocaleString('zh-CN') : ''\n    },\n    async fetchList() {\n      this.loading = true\n      try {\n        const res = await maintenanceApi.getList(this.query)\n        if (res.code === 200) {\n          this.list = res.data.list\n          this.total = res.data.total\n        }\n      } finally {\n        this.loading = false\n      }\n    },\n    handlePageChange(page) {\n      this.query.page = page\n      this.fetchList()\n    },\n    handleSizeChange(size) {\n      this.query.pageSize = size\n      this.query.page = 1\n      this.fetchList()\n    },\n    async handleDelete(id) {\n      await maintenanceApi.delete(id)\n      this.$message.success('删除成功')\n      this.fetchList()\n    }\n  }\n}\n</script>\n"],"mappings":";;;AAuFA,SAAAA,cAAA;AAEA;EACAC,IAAA;EACAC,IAAA,WAAAA,KAAA;IACA;MACAC,IAAA;MACAC,KAAA;MACAC,OAAA;MACAC,KAAA;QAAAC,IAAA;QAAAC,QAAA;QAAAC,OAAA;QAAAC,MAAA;QAAAC,QAAA;QAAAC,QAAA;MAAA;MACAC,WAAA;QAAAC,UAAA;QAAAC,QAAA;QAAAC,SAAA;QAAAC,WAAA;QAAAC,KAAA;QAAAC,IAAA;QAAAC,KAAA;MAAA;MACAC,WAAA;QAAAC,GAAA;QAAAC,MAAA;QAAAC,IAAA;QAAAC,MAAA;MAAA;MACAC,SAAA;QAAAC,OAAA;QAAAC,UAAA;QAAAC,SAAA;QAAAC,QAAA;MAAA;MACAC,YAAA;QAAAT,GAAA;QAAAC,MAAA;QAAAC,IAAA;QAAAC,MAAA;MAAA;MACAO,UAAA;QAAAL,OAAA;QAAAC,UAAA;QAAAC,SAAA;QAAAC,QAAA;MAAA;IACA;EACA;EACAG,OAAA,WAAAA,QAAA;IACA,KAAAC,SAAA;EACA;EACAC,OAAA;IACAC,UAAA,WAAAA,WAAAC,CAAA;MACA,OAAAA,CAAA,OAAAC,IAAA,CAAAD,CAAA,EAAAE,cAAA;IACA;IACAL,SAAA,WAAAA,UAAA;MAAA,IAAAM,KAAA;MAAA,OAAAC,iBAAA,cAAAC,YAAA,GAAAC,CAAA,UAAAC,QAAA;QAAA,IAAAC,GAAA;QAAA,OAAAH,YAAA,GAAAI,CAAA,WAAAC,QAAA;UAAA,kBAAAA,QAAA,CAAAC,CAAA,GAAAD,QAAA,CAAAE,CAAA;YAAA;cACAT,KAAA,CAAAnC,OAAA;cAAA0C,QAAA,CAAAC,CAAA;cAAAD,QAAA,CAAAE,CAAA;cAAA,OAEAjD,cAAA,CAAAkD,OAAA,CAAAV,KAAA,CAAAlC,KAAA;YAAA;cAAAuC,GAAA,GAAAE,QAAA,CAAAI,CAAA;cACA,IAAAN,GAAA,CAAAO,IAAA;gBACAZ,KAAA,CAAArC,IAAA,GAAA0C,GAAA,CAAA3C,IAAA,CAAAC,IAAA;gBACAqC,KAAA,CAAApC,KAAA,GAAAyC,GAAA,CAAA3C,IAAA,CAAAE,KAAA;cACA;YAAA;cAAA2C,QAAA,CAAAC,CAAA;cAEAR,KAAA,CAAAnC,OAAA;cAAA,OAAA0C,QAAA,CAAAM,CAAA;YAAA;cAAA,OAAAN,QAAA,CAAAO,CAAA;UAAA;QAAA,GAAAV,OAAA;MAAA;IAEA;IACAW,gBAAA,WAAAA,iBAAAhD,IAAA;MACA,KAAAD,KAAA,CAAAC,IAAA,GAAAA,IAAA;MACA,KAAA2B,SAAA;IACA;IACAsB,gBAAA,WAAAA,iBAAAC,IAAA;MACA,KAAAnD,KAAA,CAAAE,QAAA,GAAAiD,IAAA;MACA,KAAAnD,KAAA,CAAAC,IAAA;MACA,KAAA2B,SAAA;IACA;IACAwB,YAAA,WAAAA,aAAAC,EAAA;MAAA,IAAAC,MAAA;MAAA,OAAAnB,iBAAA,cAAAC,YAAA,GAAAC,CAAA,UAAAkB,SAAA;QAAA,OAAAnB,YAAA,GAAAI,CAAA,WAA