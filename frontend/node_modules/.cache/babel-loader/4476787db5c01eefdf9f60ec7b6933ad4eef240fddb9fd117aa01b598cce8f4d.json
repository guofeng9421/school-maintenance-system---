this.$route.path\n      if (path.startsWith('/maintenance')) return '/maintenance'\n      return path\n    },\n    user() {\n      return this.$store.state.user.user\n    },\n    isAdmin() {\n      return this.$store.getters['user/isAdmin']\n    }\n  },\n  methods: {\n    handleLogout() {\n      this.$store.dispatch('user/logout')\n      this.$router.push('/login')\n    }\n  }\n}\n</script>\n\n<style scoped lang=\"scss\">\n.layout-aside {\n  background: #304156;\n  overflow-y: auto;\n}\n.logo {\n  height: 60px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  gap: 8px;\n  color: #fff;\n  font-size: 16px;\n  font-weight: bold;\n  border-bottom: 1px solid #3a4a5c;\n}\n.layout-header {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  background: #fff;\n  border-bottom: 1px solid #e6e6e6;\n  box-shadow: 0 1px 4px rgba(0,0,0,0.08);\n}\n.header-right {\n  .user-info {\n    display: flex;\n    align-items: center;\n    gap: 8px;\n    cursor: pointer;\n  }\n  .user-name {\n    font-size: 14px;\n    color: #303133;\n  }\n  .user-role {\n    font-size: 12px;\n    color: #909399;\n  }\n}\n.layout-main {\n  background: #f0f2f5;\n  padding: 20px;\n  overflow: auto;\n}\n</style>\n"],"mappings":";;AAqEA;EACAA,IAAA;EACAC,IAAA,WAAAA,KAAA;IACA;MACAC,OAAA;QAAAC,KAAA;QAAAC,OAAA;QAAAC,OAAA;QAAAC,WAAA;MAAA;IACA;EACA;EACAC,QAAA;IACAC,UAAA,WAAAA,WAAA;MACA,IAAAC,IAAA,QAAAC,MAAA,CAAAD,IAAA;MACA,IAAAA,IAAA,CAAAE,UAAA;MACA,OAAAF,IAAA;IACA;IACAG,IAAA,WAAAA,KAAA;MACA,YAAAC,MAAA,CAAAC,KAAA,CAAAF,IAAA,CAAAA,IAAA;IACA;IACAG,OAAA,WAAAA,QAAA;MACA,YAAAF,MAAA,CAAAG,OAAA;IACA;EACA;EACAC,OAAA;IACAC,YAAA,WAAAA,aAAA;MACA,KAAAL,MAAA,CAAAM,QAAA;MACA,KAAAC,OAAA,CAAAC,IAAA;IACA;EACA;AACA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}