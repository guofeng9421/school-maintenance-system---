 }}</el-descriptions-item>\r\n            <el-descriptions-item label=\"维修位置\">{{ record.location }}</el-descriptions-item>\r\n            <el-descriptions-item label=\"楼栋\">{{ record.building }}</el-descriptions-item>\r\n            <el-descriptions-item label=\"楼层\">{{ record.floor }}</el-descriptions-item>\r\n            <el-descriptions-item label=\"房间\">{{ record.room }}</el-descriptions-item>\r\n            <el-descriptions-item label=\"维修分类\">\r\n              <el-tag>{{record.category}}</el-tag>\r\n            </el-descriptions-item>\r\n            <el-descriptions-item label=\"维修子类\">\r\n              <el-tag v-for=\"item in record.sub_category\" :key=\"item\" type=\"info\" size=\"small\">{{ item }}</el-tag>\r\n            </el-descriptions-item>\r\n            <el-descriptions-item label=\"状态\">\r\n              <el-tag :type=\"statusType[record.status]\">{{ statusMap[record.status] }}</el-tag>\r\n            </el-descriptions-item>\r\n            <el-descriptions-item label=\"提交人\">{{ record.reporter_name }}</el-descriptions-item>\r\n            <el-descriptions-item label=\"提交时间\">{{ formatDate(record.created_at) }}</el-descriptions-item>\r\n            <el-descriptions-item label=\"维修公司\">{{ record.handler_name || '-' }}</el-descriptions-item>\r\n            <el-descriptions-item label=\"开始维修时间\">{{ formatDateOnly(record.assigned_at) || '-' }}</el-descriptions-item>\r\n            <el-descriptions-item label=\"维修结束时间\">{{ formatDateOnly(record.completed_at) || '-' }}</el-descriptions-item>\r\n            <el-descriptions-item label=\"问题描述\" :span=\"2\">{{ record.description || '无' }}</el-descriptions-item>\r\n            <!-- 现场图片：有图片时显示缩略图，点击可预览大图 -->\r\n            <el-descriptions-item label=\"现场图片\" :span=\"2\" v-if=\"record.images && record.images.length\">\r\n              <div style=\"display:flex;flex-wrap:wrap;gap:8px;\">\r\n                <el-image v-for=\"(img, idx) in record.images\" :key=\"idx\" :src=\"img\" :preview-src-list=\"record.images\" fit=\"cover\" style=\"width:100px;height:100px;border-radius:4px;\" />\r\n              </div>\r\n            </el-descriptions-item>\r\n            <el-descriptions-item label=\"关联模型构件\" :span=\"2\">\r\n              <el-tag v-if=\"record.model_element_id\" type=\"success\">\r\n                {{ record.model_element_name || record.model_element_id }}\r\n                <!-- 点击跳转到 BIM 页面，传递 elementId 用于自动定位构件 -->\r\n                <el-button type=\"text\" size=\"small\" @click=\"$router.push({ path: '/bim', query: { model_element_id: record.model_element_id } })\" style=\"margin-left:8px;\">查看模型</el-button>\r\n              </el-tag>\r\n              <span v-else style=\"color:#909399;\">未关联</span>\r\n            </el-descriptions-item>\r\n          </el-descriptions>\r\n        </el-col>\r\n        <el-col :span=\"6\">\r\n          <el-card shadow=\"never\" style=\"margin-bottom:16px;\">\r\n            <div slot=\"header\"><span>状态流转</span></div>\r\n            <el-steps direction=\"vertical\" :active=\"activeStep\" finish-status=\"success\" style=\"height: 260px;\">\r\n              <el-step title=\"提交时间\" :description=\"formatDate(record.created_at)\" />\r\n              <el-step title=\"处理中\" :description=\"record.status === 'processing' ? '已分配' : '待处理'\" />\r\n              <el-step title=\"已完成\" :description=\"record.completed_at ? formatDate(record.completed_at) : ''\" />\r\n            </el-steps>\r\n          </el-card>\r\n          <el-card shadow=\"never\" v-if=\"record.status === 'pending' || record.status === 'processing'\">\r\n            <div slot=\"header\"><span>快速操作</span></div>\r\n            <div style=\"display:flex;flex-direction:column;gap:8px;\">\r\n              <!-- 待处理工单无需「开始处理」，直接标记完成 -->\r\n              <el-button type=\"success\" @click=\"changeStatus('completed')\">标记完成</el-button>\r\n            </div>\r\n          </el-card>\r\n        </el-col>\r\n      </el-row>\r\n    </el-card>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { statusMap, statusType } from \"@/config/constants\";\r\nimport { formatDate, formatDateOnly } from \"@/utils\";\r\n\r\nexport default {\r\n  name: \"MaintenanceDetailView\",\r\n  data() {\r\n    return {\r\n      loading: true,\r\n      record: {\r\n        id: \"\",\r\n        title: \"\",\r\n        description: \"\",\r\n        location: \"\",\r\n        building: \"\",\r\n        floor: \"\",\r\n        room: \"\",\r\n        category: \"other\",\r\n        status: \"processing\",\r\n        reporter_name: \"\",\r\n        handler_name: \"\",\r\n        created_at: \"\",\r\n        completed_at: \"\",\r\n        assigned_at: \"\",\r\n        completed_at: \"\",\r\n        model_element_id: \"\",\r\n        model_element_name: \"\",\r\n        images: [],\r\n        sub_category: [],\r\n      },\r\n      statusMap,\r\n      statusType,\r\n    };\r\n  },\r\n  computed: {\r\n    activeStep() {\r\n      const map = { processing: 2, completed: 3 };\r\n      return map[this.record.status] !== undefined\r\n        ? map[this.record.status]\r\n        : 2;\r\n    },\r\n  },\r\n  mounted() {\r\n    this.fetchDetail();\r\n  },\r\n  activated() {\r\n    this.fetchDetail();\r\n  },\r\n  methods: {\r\n    formatDate,\r\n    formatDateOnly,\r\n    async fetchDetail() {\r\n      this.loading = true;\r\n      try {\r\n        const res = await this.$API.maintenanceApi.getDetail(\r\n          this.$route.params.id\r\n        );\r\n        if (res.code === 200) {\r\n          Object.assign(this.record, res.data);\r\n        }\r\n      } finally {\r\n        this.loading = false;\r\n      }\r\n    },\r\n    async changeStatus(status) {\r\n      const statusLabel = {\r\n        processing: \"处理中\",\r\n        completed: \"已完成\",\r\n      };\r\n      const payload = { status };\r\n      // 标记完成时把当前操作时间写入结束时间（后端只解析 yyyy-MM-dd）\r\n      if (status === \"completed\") {\r\n        const now = new Date();\r\n        const pad = (v) => (\"0\" + v).slice(-2);\r\n        payload.completed_at = `${now.getFullYear()}-${pad(\r\n          now.getMonth() + 1\r\n        )}-${pad(now.getDate())}`;\r\n      }\r\n      const res = await this.$API.maintenanceApi.update(\r\n        this.$route.params.id,\r\n        payload\r\n      );\r\n      if (res.code === 200) {\r\n        this.$message.success(`已标记为${statusLabel[status]}`);\r\n      }\r\n      this.fetchDetail();\r\n    },\r\n  },\r\n};\r\n</script>\r\n"],"mappings":";;;;;AAyEA,SAAAA,SAAA,EAAAC,UAAA;AACA,SAAAC,UAAA,EAAAC,cAAA;AAEA;EACAC,IAAA;EACAC,IAAA,WAAAA,KAAA;IACA;MACAC,OAAA;MACAC,MAAA,EAAAC,eAAA,CAAAA,eAAA,CAAAA,eAAA,CAAAA,eAAA,CAAAA,eAAA;QACAC,EAAA;QACAC,KAAA;QACAC,WAAA;QACAC,QAAA;QACAC,QAAA;QACAC,KAAA;QACAC,IAAA;QACAC,QAAA;QACAC,MAAA;QACAC,aAAA;QACAC,YAAA;QACAC,UAAA;QACAC,YAAA;QACAC,WAAA;MAAA,mBACA,yBACA,2BACA,eACA,qBACA,GACA;MACAtB,SAAA,EAAAA,SAAA;MACAC,UAAA,EAAAA;IACA;EACA;EACAsB,QAAA;IACAC,UAAA,WAAAA,WAAA;MACA,IAAAC,GAAA;QAAAC,UAAA;QAAAC,SAAA;MAAA;MACA,OAAAF,GAAA,MAAAlB,MAAA,CAAAU,MAAA,MAAAW,SAAA,GACAH,GAAA,MAAAlB,MAAA,CAAAU,MAAA,IACA;IACA;EACA;EACAY,OAAA,WAAAA,QAAA;IACA,KAAAC,WAAA;EACA;EACAC,SAAA,WAAAA,UAAA;IACA,KAAAD,WAAA;EACA;EACAE,OAAA;IACA9B,UAAA,EAAAA,UAAA;IACAC,cAAA,EAAAA,cAAA;IACA2B,WAAA,WAAAA,YAAA;MAAA,IAAAG,KAAA;MAAA,OAAAC,iBAAA,cAAAC,YAAA,GAAAC,CAAA,UAAAC,QAAA;QAAA,IAAAC,GAAA;QAAA,OAAAH,YAAA,GAAAI,CAAA,WAAAC,QAAA;UAAA,kBAAAA,QAAA,CAAAC,CAAA,GAAAD,QAAA,CAAAE,CAAA;YAAA;cACAT,KAAA,CAAA3B,OAAA;cAAAkC,QAAA,CAAAC,CAAA;cAAAD,QAAA,CAAAE,CAAA;cAAA,OAEAT,KAAA,CAAAU,IAAA,CAAAC,cAAA,CAAAC,SAAA,CACAZ,KAAA,CAAAa,MAAA,CAAAC,MAAA,CAAAtC,EACA;YAAA;cAFA6B,GAAA,GAAAE,QAAA,CAAAQ,CAAA;cAGA,IAAAV,GAAA,CAAAW,IAAA;gBACAC,MAAA,CAAAC,MAAA,CAAAlB,KAAA,CAAA1B,MAAA,EAAA+B,GAAA,CAAAjC,IAAA;cACA;YAAA;cAAAmC,QAAA,CAAAC,CAAA;cAEAR,KAAA,CAAA3B,OAAA;cAAA,OAAAkC,QAAA,CAAAY,CAAA;YAAA;cAAA,OAAAZ,QAAA,CAAAa,CAAA;UAAA;QAAA,GAAAhB,OAAA;MAAA;IAEA;IACAiB,YAAA,WAAAA,aAAArC,MAAA;MAAA,IAAAsC,MAAA;MAAA,OAAArB,iBAAA,cAAAC,YAAA,GAAAC,CAAA,UAAAoB,SAAA;QAAA,IAAAC,WAAA,EAAAC,OAAA,EAAAC,GAAA,EAAAC,GAAA,EAAAtB,GAAA;QAAA,OAAAH,Y