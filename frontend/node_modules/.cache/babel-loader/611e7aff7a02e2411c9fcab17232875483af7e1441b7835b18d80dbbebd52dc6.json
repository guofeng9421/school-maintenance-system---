             }\n            case 3:\n              _context.p = 3;\n              _this.loading = false;\n              return _context.f(3);\n            case 4:\n              return _context.a(2);\n          }\n        }, _callee, null, [[1,, 3, 4]]);\n      }))();\n    },\n    // 切换页码\n    handlePageChange: function handlePageChange(page) {\n      this.query.page = page;\n      this.fetchList();\n    },\n    // 切换每页条数（重置到第一页）\n    handleSizeChange: function handleSizeChange(size) {\n      this.query.pageSize = size;\n      this.query.page = 1;\n      this.fetchList();\n    },\n    // 删除记录：调用API后刷新列表\n    handleDelete: function handleDelete(id) {\n      var _this2 = this;\n      return _asyncToGenerator(/*#__PURE__*/_regenerator().m(function _callee2() {\n        return _regenerator().w(function (_context2) {\n          while (1) switch (_context2.n) {\n            case 0:\n              _context2.n = 1;\n              return _this2.$API.maintenanceApi.remove(id);\n            case 1:\n              _this2.$message.success(\"删除成功\");\n              _this2.fetchList();\n            case 2:\n              return _context2.a(2);\n          }\n        }, _callee2);\n      }))();\n    }\n  }\n};","map":{"version":3,"names":["categoryMap","statusMap","statusType","formatDate","formatDateOnly","name","data","list","total","loading","query","page","pageSize","keyword","status","category","mounted","fetchList","methods","_this","_asyncToGenerator","_regenerator","m","_callee","res","w","_context","p","n","$API","maintenanceApi","getList","v","console","log","code","f","a","handlePageChange","handleSizeChange","size","handleDelete","id","_this2","_callee2","_context2","remove","$message","success"],"sources":["src/views/maintenance/MaintenanceListView.vue"],"sourcesContent":["<template>\n  <div class=\"page-container\">\n    <div class=\"filter-bar\">\n      <el-input v-model=\"query.keyword\" placeholder=\"搜索标题/位置\" clearable style=\"width:220px\" @clear=\"fetchList\" @keyup.enter.native=\"fetchList\" />\n      <el-select v-model=\"query.status\" placeholder=\"状态\" clearable style=\"width:130px\" @change=\"fetchList\">\n        <el-option label=\"待处理\" value=\"pending\" />\n        <el-option label=\"已完成\" value=\"completed\" />\n      </el-select>\n      <el-select v-model=\"query.category\" placeholder=\"分类\" clearable style=\"width:130px\" @change=\"fetchList\">\n        <el-option  v-for=\"item in category\" :key=\"item.value\" :label=\"item.label\" />\n       \n      </el-select>\n      <el-button type=\"primary\" @click=\"fetchList\">\n        <i class=\"el-icon-search\"></i> 搜索\n      </el-button>\n      <el-button type=\"success\" @click=\"$router.push('/maintenance/create')\">\n        <i class=\"el-icon-plus\"></i> 新建维修\n      </el-button>\n    </div>\n\n    <el-table :data=\"list\" stripe v-loading=\"loading\" style=\"width:100%\">\n      <el-table-column prop=\"id\" label=\"编号\" width=\"130\" />\n      <el-table-column prop=\"title\" label=\"维修标题\" min-width=\"160\" show-overflow-tooltip />\n      <el-table-column prop=\"location\" label=\"位置\" min-width=\"160\" show-overflow-tooltip />\n      <el-table-column prop=\"building\" label=\"楼栋\" />\n      <el-table-column prop=\"category\" label=\"分类\" width=\"90\">\n        <template slot-scope=\"{ row }\">{{row.category}}</template>\n      </el-table-column>\n      <el-table-column prop=\"status\" label=\"状态\" width=\"90\">\n        <template slot-scope=\"{ row }\">\n          <el-tag :type=\"statusType[row.status]\">{{ statusMap[row.status]}}</el-tag>\n        </template>\n      </el-table-column>\n      <el-table-column prop=\"reporter_name\" label=\"提交人\" width=\"90\" />\n      <el-table-column prop=\"created_at\" label=\"提交时间\" width=\"170\">\n        <template slot-scope=\"{ row }\">{{ formatDate(row.created_at) }}</template>\n      </el-table-column>\n      <el-table-column prop=\"assigned_at\" label=\"开始维修时间\" width=\"100\">\n        <template slot-scope=\"{ row }\">{{ formatDateOnly(row.assigned_at) }}</template>\n      </el-table-column>\n      <el-table-column prop=\"completed_at\" label=\"结束维修时间\" width=\"100\">\n        <template slot-scope=\"{ row }\">{{ formatDateOnly(row.completed_at) }}</template>\n      </el-table-column>\n      <el-table-column label=\"模型关联\" width=\"90\">\n        <template slot-scope=\"{ row }\">\n          <el-tag v-if=\"row.model_element_id\" type=\"success\" size=\"small\">已关联</el-tag>\n          <el-tag v-else type=\"info\" size=\"small\">未关联</el-tag>\n        </template>\n      </el-table-column>\n      <!-- 图片列：显示最多3张缩略图，点击可预览大图，超出部分显示+N -->\n      <el-table-column label=\"图片\" width=\"120\">\n        <template slot-scope=\"{ row }\">\n          <div v-if=\"row.images && row.images.length\" style=\"display:flex;gap:4px;flex-wrap:wrap;\">\n            <el-image v-for=\"(img, idx) in row.images.slice(0, 3)\" :key=\"idx\" :src=\"img\" :preview-src-list=\"row.images\" fit=\"cover\" style=\"width:36px;height:36px;border-radius:4px;cursor:pointer;\" />\n            <span v-if=\"row.images.length > 3\" style=\"font-size:12px;color:#909399;line-height:36px;\">+{{ row.images.length - 3 }}</span>\n          </div>\n          <span v-else style=\"color:#c0c4cc;\">-</span>\n        </template>\n      </el-table-column>\n      <el-table-column label=\"操作\" width=\"180\" fixed=\"right\">\n        <template slot-scope=\"{ row }\">\n          <el-button type=\"text\" size=\"small\" @click=\"$router.push(`/maintenance/detail/${row.id}`)\">详情</el-button>\n          <el-button type=\"text\" size=\"small\" @click=\"$router.push(`/maintenance/edit/${row.id}`)\">编辑</el-button>\n          <el-popconfirm title=\"确认删除?\" @confirm=\"handleDelete(row.id)\">\n            <el-button slot=\"reference\" type=\"text\" size=\"small\" style=\"color:#f56c6c;\">删除</el-button>\n          </el-popconfirm>\n        </template>\n      </el-table-column>\n    </el-table>\n\n    <el-pagination v-if=\"total > 0\" style=\"margin-top: 16px; text-align: right;\" :current-page=\"query.page\" :page-size=\"query.pageSize\" :total=\"total\" :page-sizes=\"[10, 20, 50]\" layout=\"total, sizes, prev, pager, next, jumper\" @current-change=\"handlePageChange\" @size-change=\"handleSizeChange\" />\n  </div>\n</template>\n\n<script>\nimport { categoryMap, statusMap, statusType } from \"../../config/constants\";\nimport { formatDate, formatDateOnly } from \"../../utils\";\n\n// 维修记录列表页面：展示所有维修记录，支持搜索、筛选、分页\nexport default {\n  name: \"MaintenanceListView\",\n  data() {\n    return {\n      list: [], // 列表数据\n      total: 0, // 总记录数（用于分页）\n      loading: false, // 表格loading状态\n      // 查询参数：页码、每页条数、关键词、状态、分类、优先级\n      query: {\n        page: 1,\n        pageSize: 10,\n        keyword: \"\",\n        status: \"\",\n        category: \"\",\n      },\n      categoryMap,\n      statusMap,\n      statusType,\n    };\n  },\n  mounted() {\n    this.fetchList(); // 页面加载时获取列表数据\n  },\n  methods: {\n    formatDate, // 格式化日期工具函数\n    formatDateOnly, // 格式化日期（仅显示年月日）工具函数\n    // 从后端获取维修记录列表\n    async fetchList() {\n      this.loading = true;\n      try {\n        const res = await this.$API.maintenanceApi.getList(this.query);\n        console.log(\"获取维修列表:\", res);\n        if (res.code === 200) {\n          this.list = res.data.list;\n          this.total = res.data.total;\n        }\n      } finally {\n        this.loading = false;\n      }\n    },\n    // 切换页码\n    handlePageChange(page) {\n      this.query.page = page;\n      this.fetchList();\n    },\n    // 切换每页条数（重置到第一页）\n    handleSizeChange(size) {\n      this.query.pageSize = size;\n      this.query.page = 1;\n      this.fetchList();\n    },\n    // 删除记录：调用API后刷新列表\n    async handleDelete(id) {\n      await this.$API.maintenanceApi.remove(id);\n      this.$message.success(\"删除成功\");\n      this.fetchList();\n    },\n  },\n};\n</script>\n"],"mappings":";;AA2EA,SAAAA,WAAA,EAAAC,SAAA,EAAAC,UAAA;AACA,SAAAC,UAAA,EAAAC,cAAA;;AAEA;AACA;EACAC,IAAA;EACAC,IAAA,WAAAA,KAAA