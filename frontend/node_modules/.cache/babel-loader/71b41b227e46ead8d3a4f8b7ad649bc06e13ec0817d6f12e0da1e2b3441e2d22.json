{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport \"core-js/modules/es.string.starts-with.js\";\nimport { roleMap } from \"../config/constants\";\n\n// 主布局组件：包含左侧导航栏 + 顶部栏 + 内容区域\nexport default {\n  name: \"LayoutView\",\n  data: function data() {\n    return {\n      roleMap: roleMap\n    }; // 角色名称映射表\n  },\n  computed: {\n    // 当前激活的菜单项：维修相关页面统一高亮\"维修记录\"菜单\n    activeMenu: function activeMenu() {\n      var path = this.$route.path;\n      if (path.startsWith(\"/maintenance\")) return \"/maintenance\";\n      return path;\n    },\n    // 当前登录用户信息（从 Vuex store 获取）\n    user: function user() {\n      return this.$store.state.user.user;\n    },\n    // 是否为管理员角色（控制\"用户管理\"菜单的显示）\n    isAdmin: function isAdmin() {\n      return this.$store.getters[\"user/isAdmin\"];\n    }\n  },\n  methods: {\n    // 退出登录：清除状态并跳转到登录页\n    handleLogout: function handleLogout() {\n      this.$store.dispatch(\"user/logout\");\n      this.$router.push(\"/login\");\n    }\n  }\n};","map":{"version":3,"names":["roleMap","name","data","computed","activeMenu","path","$route","startsWith","user","$store","state","isAdmin","getters","methods","handleLogout","dispatch","$router","push"],"sources":["src/views/LayoutView.vue"],"sourcesContent":["<template>\n  <div class=\"layout-container\">\n    <el-container style=\"height: 100vh;\">\n      <el-aside width=\"220px\" class=\"layout-aside\">\n        <div class=\"logo\">\n          <i class=\"el-icon-setting\" style=\"font-size: 24px;\"></i>\n          <span>维修管理系统</span>\n        </div>\n        <el-menu :default-active=\"activeMenu\" router background-color=\"#304156\" text-color=\"#bfcbd9\" active-text-color=\"#409eff\">\n          <el-menu-item index=\"/dashboard\">\n            <i class=\"el-icon-data-line\"></i>\n            <span>数据看板</span>\n          </el-menu-item>\n          <el-menu-item index=\"/bim\">\n            <i class=\"el-icon-view\"></i>\n            <span>BIM模型</span>\n          </el-menu-item>\n          <el-menu-item index=\"/maintenance\">\n            <i class=\"el-icon-document\"></i>\n            <span>维修记录</span>\n          </el-menu-item>\n          <el-menu-item index=\"/maintenance/create\">\n            <i class=\"el-icon-plus\"></i>\n            <span>新建报修</span>\n          </el-menu-item>\n          <el-menu-item v-if=\"isAdmin\" index=\"/users\">\n            <i class=\"el-icon-user\"></i>\n            <span>用户管理</span>\n          </el-menu-item>\n        </el-menu>\n      </el-aside>\n      <el-container>\n        <el-header class=\"layout-header\">\n          <div class=\"header-left\">\n            <el-breadcrumb separator=\"/\">\n              <el-breadcrumb-item :to=\"{ path: '/' }\">首页</el-breadcrumb-item>\n              <el-breadcrumb-item v-if=\"$route.meta.title\">{{ $route.meta.title }}</el-breadcrumb-item>\n            </el-breadcrumb>\n          </div>\n          <div class=\"header-right\">\n            <el-dropdown trigger=\"click\">\n              <span class=\"user-info\">\n                <el-avatar :size=\"32\" style=\"background:#409eff\">\n                  {{ user && user.real_name ? user.real_name.charAt(0) : '' }}\n                </el-avatar>\n                <span class=\"user-name\">{{ user ? user.real_name : '' }}</span>\n                <span class=\"user-role\">{{ roleMap[user ? user.role : ''] }}</span>\n              </span>\n              <el-dropdown-menu slot=\"dropdown\">\n                <el-dropdown-item @click.native=\"handleLogout\">退出登录</el-dropdown-item>\n              </el-dropdown-menu>\n            </el-dropdown>\n          </div>\n        </el-header>\n        <el-main class=\"layout-main\">\n          <keep-alive v-if=\"this.$route.params.id\" >\n            <router-view>\n          </keep-alive>\n           <keep-alive v-else>\n            <router-view>\n          </keep-alive>\n          <router-view />\n        </el-main>\n      </el-container>\n    </el-container>\n  </div>\n</template>\n\n<script>\nimport { roleMap } from \"../config/constants\";\n\n// 主布局组件：包含左侧导航栏 + 顶部栏 + 内容区域\nexport default {\n  name: \"LayoutView\",\n  data() {\n    return { roleMap }; // 角色名称映射表\n  },\n  computed: {\n    // 当前激活的菜单项：维修相关页面统一高亮\"维修记录\"菜单\n    activeMenu() {\n      const path = this.$route.path;\n      if (path.startsWith(\"/maintenance\")) return \"/maintenance\";\n      return path;\n    },\n    // 当前登录用户信息（从 Vuex store 获取）\n    user() {\n      return this.$store.state.user.user;\n    },\n    // 是否为管理员角色（控制\"用户管理\"菜单的显示）\n    isAdmin() {\n      return this.$store.getters[\"user/isAdmin\"];\n    },\n  },\n  methods: {\n    // 退出登录：清除状态并跳转到登录页\n    handleLogout() {\n      this.$store.dispatch(\"user/logout\");\n      this.$router.push(\"/login\");\n    },\n  },\n};\n</script>\n\n<style scoped lang=\"scss\">\n.layout-aside {\n  background: #304156;\n  overflow-y: auto;\n}\n.logo {\n  height: 60px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  gap: 8px;\n  color: #fff;\n  font-size: 16px;\n  font-weight: bold;\n  border-bottom: 1px solid #3a4a5c;\n}\n.layout-header {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  background: #fff;\n  border-bottom: 1px solid #e6e6e6;\n  box-shadow: 0 1px 4px rgba(0, 0, 0, 0.08);\n}\n.header-right {\n  .user-info {\n    display: flex;\n    align-items: center;\n    gap: 8px;\n    cursor: pointer;\n  }\n  .user-name {\n    font-size: 14px;\n    color: #303133;\n  }\n  .user-role {\n    font-size: 12px;\n    color: #909399;\n  }\n}\n.layout-main {\n  background: #f0f2f5;\n  padding: 20px;\n  overflow: auto;\n}\n</style>\n"],"mappings":";;AAqEA,SAAAA,OAAA;;AAEA;AACA;EACAC,IAAA;EACAC,IAAA,WAAAA,KAAA;IACA;MAAAF,OAAA,EAAAA;IAAA;EACA;EACAG,QAAA;IACA;IACAC,UAAA,WAAAA,WAAA;MACA,IAAAC,IAAA,QAAAC,MAAA,CAAAD,IAAA;MACA,IAAAA,IAAA,CAAAE,UAAA;MACA,OAAAF,IAAA;IACA;IACA;IACAG,IAAA,WAAAA,KAAA;MACA,YAAAC,MAAA,CAAAC,KAAA,CAAAF,IAAA,CAAAA,IAAA;IACA;IACA;IACAG,OAAA,WAAAA,QAAA;MACA,YAAAF,MAAA,CAAAG,OAAA;IACA;EACA;EACAC,OAAA;IACA;IACAC,YAAA,WAAAA,aAAA;MACA,KAAAL,MAAA,CAAAM,QAAA;MACA,KAAAC,OAAA,CAAAC,IAAA;IACA;EACA;AACA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}