ocation }}</el-descriptions-item>\n            <el-descriptions-item label=\"楼栋\">{{ record.building }}</el-descriptions-item>\n            <el-descriptions-item label=\"楼层\">{{ record.floor }}</el-descriptions-item>\n            <el-descriptions-item label=\"房间\">{{ record.room }}</el-descriptions-item>\n            <el-descriptions-item label=\"维修分类\">\n              <el-tag>{{record.category}}</el-tag>\n            </el-descriptions-item>\n            <el-descriptions-item label=\"维修子类\">\n              <el-tag v-for=\"item in record.sub_category\" :key=\"item\" type=\"info\" size=\"small\">{{ item }}</el-tag>\n            </el-descriptions-item>\n            <el-descriptions-item label=\"状态\">\n              <el-tag :type=\"statusType[record.status]\">{{ statusMap[record.status] }}</el-tag>\n            </el-descriptions-item>\n            <el-descriptions-item label=\"提交人\">{{ record.reporter_name }}</el-descriptions-item>\n            <el-descriptions-item label=\"提交时间\">{{ formatDate(record.created_at) }}</el-descriptions-item>\n            <el-descriptions-item label=\"维修公司\">{{ record.handler_name || '-' }}</el-descriptions-item>\n            <el-descriptions-item label=\"开始维修时间\">{{ formatDateOnly(record.assigned_at) || '-' }}</el-descriptions-item>\n            <el-descriptions-item label=\"维修结束时间\">{{ formatDateOnly(record.completed_at) || '-' }}</el-descriptions-item>\n            <el-descriptions-item label=\"问题描述\" :span=\"2\">{{ record.description || '无' }}</el-descriptions-item>\n            <!-- 现场图片：有图片时显示缩略图，点击可预览大图 -->\n            <el-descriptions-item label=\"现场图片\" :span=\"2\" v-if=\"record.images && record.images.length\">\n              <div style=\"display:flex;flex-wrap:wrap;gap:8px;\">\n                <el-image v-for=\"(img, idx) in record.images\" :key=\"idx\" :src=\"img\" :preview-src-list=\"record.images\" fit=\"cover\" style=\"width:100px;height:100px;border-radius:4px;\" />\n              </div>\n            </el-descriptions-item>\n            <el-descriptions-item label=\"关联模型构件\" :span=\"2\">\n              <el-tag v-if=\"record.model_element_id\" type=\"success\">\n                {{ record.model_element_name || record.model_element_id }}\n                <!-- 点击跳转到 BIM 页面，传递 elementId 用于自动定位构件 -->\n                <el-button type=\"text\" size=\"small\" @click=\"$router.push({ path: '/bim', query: { model_element_id: record.model_element_id } })\" style=\"margin-left:8px;\">查看模型</el-button>\n              </el-tag>\n              <span v-else style=\"color:#909399;\">未关联</span>\n            </el-descriptions-item>\n          </el-descriptions>\n        </el-col>\n        <el-col :span=\"6\">\n          <el-card shadow=\"never\" style=\"margin-bottom:16px;\">\n            <div slot=\"header\"><span>状态流转</span></div>\n            <el-steps direction=\"vertical\" :active=\"activeStep\" finish-status=\"success\" style=\"height: 260px;\">\n              <el-step title=\"提交时间\" :description=\"formatDate(record.created_at)\" />\n              <el-step title=\"处理中\" :description=\"record.status === 'processing' ? '已分配' : '待处理'\" />\n              <el-step title=\"已完成\" :description=\"record.update_at ? formatDate(record.update_at) : ''\" />\n            </el-steps>\n          </el-card>\n          <el-card shadow=\"never\" v-if=\"record.status === 'processing'\">\n            <div slot=\"header\"><span>快速操作</span></div>\n            <div style=\"display:flex;flex-direction:column;gap:8px;\">\n              <el-button v-if=\"record.status === 'pending'\" type=\"warning\" @click=\"changeStatus('processing')\">开始处理</el-button>\n              <el-button v-if=\"record.status === 'processing'\" type=\"success\" @click=\"changeStatus('completed')\">标记完成</el-button>\n            </div>\n          </el-card>\n        </el-col>\n      </el-row>\n    </el-card>\n  </div>\n</template>\n\n<script>\nimport {\n  statusMap,\n  statusType,\n} from \"@/config/constants\";\nimport { formatDate, formatDateOnly } from \"@/utils\";\n\nexport default {\n  name: \"MaintenanceDetailView\",\n  data() {\n    return {\n      loading: true,\n      record: {\n        id: \"\",\n        title: \"\",\n        description: \"\",\n        location: \"\",\n        building: \"\",\n        floor: \"\",\n        room: \"\",\n        category: \"other\",\n        status: \"processing\",\n        reporter_name: \"\",\n        handler_name: \"\",\n        created_at: \"\",\n        completed_at: \"\",\n        assigned_at: \"\",\n        completed_at: \"\",\n        model_element_id: \"\",\n        model_element_name: \"\",\n        images: [],\n        sub_category:[]\n      },\n      statusMap,\n      statusType,\n    };\n  },\n  computed: {\n    activeStep() {\n      const map = {  processing: 2, completed: 3,};\n      return map[this.record.status] !== undefined\n        ? map[this.record.status]\n        : 2;\n    },\n    \n  },\n  mounted() {\n    this.fetchDetail();\n  },\n  activated() {\n    this.fetchDetail();\n  },\n  methods: {\n    formatDate,\n    formatDateOnly,\n    async fetchDetail() {\n      this.loading = true;\n      try {\n        const res = await this.$API.maintenanceApi.getDetail(\n          this.$route.params.id\n        );\n        if (res.code === 200) {\n          Object.assign(this.record, res.data);\n        }\n      } catch (e) {\n        console.error('获取详情失败:', e);\n        this.$message.error('获取详情失败');\n      } finally {\n        this.loading = false;\n      }\n    },\n    async changeStatus(status) {\n      const statusLabel = {\n        processing: \"处理中\",\n        completed: \"已完成\",\n      };\n      try {\n        const res = await this.$API.maintenanceApi.update(this.$route.params.id, {\n          status,\n        });\n        if (res.code === 200) {\n          this.$message.success(`已标记为${statusLabel[status]}`);\n        }\n        this.fetchDetail();\n      } catch (e) {\n        console.error('状态更新失败:', e);\n        this.$message.error('状态更新失败');\n      }\n    },\n  },\n};\n</script>\n"],"mappings":";;;AAyEA,SACAA,SAAA,EACAC,UAAA,QACA;AACA,SAAAC,UAAA,EAAAC,cAAA;AAEA;EACAC,IAAA;EACAC,IAAA,WAAAA,KAAA;IACA;MACAC,OAAA;MACAC,MAAA,EAAAC,eAAA,CAAAA,eAAA,CAAAA,eAAA,CAAAA,eAAA,CAAAA,eAAA;QACAC,EAAA;QACAC,KAAA;QACAC,WAAA;QACAC,QAAA;QACAC,QAAA;QACAC,KAAA;QACAC,IAAA;QACAC,QAAA;QACAC,MAAA;QACAC,aAAA;QACAC,YAAA;QACAC,UAAA;QACAC,YAAA;QACAC,WAAA;MAAA,mBACA,yBACA,2BACA,eACA,qBACA,GACA;MACAtB,SAAA,EAAAA,SAAA;MACAC,UAAA,EAAAA;IACA;EACA;EACAsB,QAAA;IACAC,UAAA,WAAAA,WAAA;MACA,IAAAC,GAAA;QAAAC,UAAA;QAAAC,SAAA;MAAA;MACA,OAAAF,GAAA,MAAAlB,MAAA,CAAAU,MAAA,MAAAW,SAAA,GACAH,GAAA,MAAAlB,MAAA,CAAAU,MAAA,IACA;IACA;EAEA;EACAY,OAAA,WAAAA,QAAA;IACA,KAAAC,WAAA;EACA;EACAC,SAAA,WAAAA,UAAA;IACA,KAAAD,WAAA;EACA;EACAE,OAAA;IACA9B,UAAA,EAAAA,UAAA;IACAC,cAAA,EAAAA,cAAA;IACA2B,WAAA,WAAAA,YAAA;MAAA,IAAAG,KAAA;MAAA,OAAAC,iBAAA,cAAAC,YAAA,GAAAC,CAAA,UAAAC,QAAA;QAAA,IAAAC,GAAA,EAAAC,EAAA;QAAA,OAAAJ,YAAA,GAAAK,CAAA,WAAAC,QAAA;UAAA,kBAAAA,QAAA,CAAAC,CAAA,GAAAD,QAAA,CAAAE,CAAA;YAAA;cACAV,KAAA,CAAA3B,OAAA;cAAAmC,QAAA,CAAAC,CAAA;cAAAD,QAAA,CAAAE,CAAA;cAAA,OAEAV,KAAA,CAAAW,IAAA,CAAAC,cAAA,CAAAC,SAAA,CACAb,KAAA,CAAAc,MAAA,CAAAC,MAAA,CAAAvC,EACA;YAAA;cAFA6B,GAAA,GAAAG,QAAA,CAAAQ,CAAA;cAGA,IAAAX,GAAA,CAAAY,IAAA;gBACAC,MAAA,CAAAC,MAAA,CAAAnB,KAAA,CAAA1B,MAAA,EAAA+B,GAAA,CAAAjC,IAAA;cACA;cAAAoC,QAAA,CAAAE,CAAA;cAAA;YAAA;cAAAF,QAAA,CAAAC,CAAA;cAAAH,EAAA,GAAAE,QAAA,CAAAQ,CAAA;cAEAI,OAAA,CAAAC,KAAA,YAAAf,EAAA;cACAN,KAAA,CAAAsB,QAAA,CAAAD,KAAA;YAAA;cAAAb,QAAA,CAAAC,CAAA;cAEAT,KAAA,CAAA3B,OAAA;cAAA,OAAAmC,QAAA,CAAAe,CAAA;YAAA;cAAA,OAAAf,QAAA,CAAAgB,CAAA;UAAA;QAAA,GAAApB,OAAA;MAAA;IAEA;IACAqB,YAAA,WAAAA,aAAAzC,MAAA;MAAA,IAAA0C,MAAA;MAAA,OAAAzB,iBAAA,cAAAC,YAAA,GAAAC,CAAA,UAAAwB,SAAA;QAAA,IAAAC,WAAA,EAAAvB,GAAA,EAAAwB,GAAA;QAAA,OAAA3B,YAAA,GAAAK,CAAA,WAAAuB,SAAA;UAAA,kBAAAA,SAAA,CAAArB,CAAA,GAAAqB,SAAA,CAAApB,CAAA;YAAA;cACAkB,WAAA;gBACAnC,UAAA;gBACAC,SAAA;cACA;cAAAoC,SAAA,CAAArB,CAAA;cAAAqB,SAAA,CAAApB,CAAA;cAAA,OAEAgB,MAAA,CAAAf,IAAA,CAAAC,cAAA,CAAAmB,MAAA,CAAAL,MAAA,CAAAZ,